# Copy to .env and fill in. Never commit the real file.

# --- Required: Spotify app credentials -------------------------------------
# Create an app at https://developer.spotify.com/dashboard, then add the
# redirect URI below to the app's settings (it must match exactly).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# --- Recommended -----------------------------------------------------------
# Signs the session cookie. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# If unset, a random one is generated at startup and everyone is signed out on restart.
SESSION_SECRET=

# --- Optional: better adjacent-artist suggestions ---------------------------
# Free key from https://www.last.fm/api/account/create
# Without this, adjacency falls back to Spotify genre overlap.
LASTFM_API_KEY=

# --- Optional: tuning -------------------------------------------------------
LIST_URL=http://www.foopee.com/punk/the-list/
LIST_TTL_SECONDS=21600
MAX_PLAYLISTS=60
ADJACENCY_CANDIDATE_CAP=400
SESSION_TTL_SECONDS=43200
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
